  {
   "id": "text_68",
   "type": "text",
   "x": -686,
   "y": 28.0,
   "width": 214.4,
   "height": 146.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
