  },
  {
   "id": "text_71",
   "type": "text",
   "x": -418,
   "y": 48.0,
   "width": 220.39,
   "height": 243.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [
    "grp_69"
   ],
   "frameId": null,
   "roundness": null,
   "strokeSharpness": "sharp",
   "seed": 84196940,
   "version": 1,
   "versionNonce": 2065920251,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1791138187199,
   "link": null,
   "locked": false,
   "text": "• Unit of prediction: customer_id\n• Prediction horizon: first 30 days\n   after signup\n• Label: 30 day LTV\n• Task type: Regression\n• Offline metric: RMSE on mean of\n   deciles\n• Serving: Online inference, or hourly\n   micro batch\n• Downstream decision: value based\n   bidding signal sent to ad platforms\n• Business KPI: Maximize ROAS\n• Guardrails: Signups and CAC hold\n• Online test: Treatment vs control,\n   campaign split",
   "originalText": "• Unit of prediction: customer_id\n• Prediction horizon: first 30 days\n   after signup\n• Label: 30 day LTV\n• Task type: Regression\n• Offline metric: RMSE on mean of\n   deciles\n• Serving: Online inference, or hourly\n   micro batch\n• Downstream decision: value based\n   bidding signal sent to ad platforms\n• Business KPI: Maximize ROAS\n• Guardrails: Signups and CAC hold\n• Online test: Treatment vs control,\n   campaign split",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 240,
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
