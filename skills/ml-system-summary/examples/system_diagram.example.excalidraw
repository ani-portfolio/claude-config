   "strokeSharpness": "sharp",
   "seed": 1625947776,
   "version": 1,
   "versionNonce": 734559256,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1791138187199,
   "link": null,
   "locked": false,
   "text": "• Digital channels only (Meta,\n   Google)\n• CAC alone is a weak business\n   metric, since low value customers\n   can also have low CAC\n• Model predicts 30 day LTV; the 12\n   month LTV sent to ad platforms is\n   30 day LTV × a cohort multiplier\n   (brand, channel, country)",
   "originalText": "• Digital channels only (Meta,\n   Google)\n• CAC alone is a weak business\n   metric, since low value customers\n   can also have low CAC\n• Model predicts 30 day LTV; the 12\n   month LTV sent to ad platforms is\n   30 day LTV × a cohort multiplier\n   (brand, channel, country)",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 143,
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
