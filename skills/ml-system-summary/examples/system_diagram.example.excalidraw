   "text": "Problem Framing and\nSuccess Metrics",
   "originalText": "Problem Framing and\nSuccess Metrics",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 36,
   "containerId": null,
   "lineHeight": 1.25,
